{
  "name": "100-mexicanos-dijeron",
  "version": "1.0.0",
  "description": "Juego de concurso estilo 100 Mexicanos Dijeron con pulsadores, marquesina, comandos de voz y todo editable.",
  "main": "main.js",
  "author": "Tu Nombre <tu-correo@ejemplo.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --ia32 --publish never",
    "dist:x64": "electron-builder --win --x64 --publish never",
    "dist:ia32": "electron-builder --win --ia32 --publish never"
  },
  "build": {
    "appId": "com.tuusuario.cienmexicanosdijeron",
    "productName": "100 Mexicanos Dijeron",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "100-Mexicanos-Dijeron-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
